# Public API: SELECT-only ucla_reader account; preferred deployment variable.
DATABASE_READER_URL=
# Legacy fallbacks, used in this order only when DATABASE_READER_URL is unset.
UCLA_DATABASE_URL=
DATABASE_URL=
# Only the local importer uses the owner connection.
UCLA_ADMIN_DATABASE_URL=
# Required when using the optional local Docker Compose service.
UCLA_LOCAL_ADMIN_PASSWORD=
